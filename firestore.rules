rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function: Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }
    
    // Helper function: Check if the user is operating on their own document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Helper function: Check if the authenticated user is an Admin
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin")
      );
    }
    
    // Helper function: Check valid student create payload
    function isValidStudentCreation(userId) {
      return isOwner(userId) &&
        (!("role" in request.resource.data) || request.resource.data.role == "student" || isAdmin());
    }
    
    // Helper function: Ensure protected fields (role, createdAt) cannot be manipulated by students
    function isValidStudentUpdate(userId) {
      return isOwner(userId) &&
        // role cannot be changed (cannot self-promote to admin)
        (!("role" in request.resource.data) || request.resource.data.role == resource.data.role) &&
        // createdAt cannot be changed or forged
        (!("createdAt" in request.resource.data) || request.resource.data.createdAt == resource.data.createdAt);
    }

    // Users Collection rules
    match /users/{userId} {
      // 1. Single Document Read (get): Student can get their own doc; Admin can get any doc
      allow get: if isOwner(userId) || isAdmin();
      
      // 2. Collection Query / List (list): ONLY Admin can list all users in the collection
      allow list: if isAdmin();
      
      // 3. Create: Student creates their own document upon registration with role="student"
      allow create: if isValidStudentCreation(userId);
      
      // 4. Update: Student updates own profile/skills without changing protected fields; Admin can update any doc
      allow update: if isValidStudentUpdate(userId) || isAdmin();
      
      // 5. Delete: Only Admin can delete user profiles
      allow delete: if isAdmin();
    }
    
    // Global fallback: Deny all unauthenticated or undeclared collection access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
