rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin")
      );
    }

    // Users collection rules
    match /users/{userId} {
      // Admin can read all users; Ordinary student can only read their own document
      allow read: if isOwner(userId) || isAdmin();
      
      // Creating user document: must be authenticated and creating own doc with role="student" (unless admin)
      allow create: if isOwner(userId) && 
        (!("role" in request.resource.data) || request.resource.data.role == "student" || isAdmin());
      
      // Updating user document: 
      // 1. Owner can update profile fields, but CANNOT change 'role' or 'createdAt' to unauthorized values
      // 2. Admin can update any document
      allow update: if (isOwner(userId) && 
        (!("role" in request.resource.data) || request.resource.data.role == resource.data.role) &&
        (!("createdAt" in request.resource.data) || request.resource.data.createdAt == resource.data.createdAt)) || isAdmin();
      
      // Deleting user document: only admin
      allow delete: if isAdmin();
    }

    // Default deny for all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
